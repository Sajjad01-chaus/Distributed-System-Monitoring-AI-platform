# Copy to .env (gitignored) and change the password before running `docker compose up`.
POSTGRES_DB=system_monitor
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=change-me

# API auth: JWT signing secret shared by all API replicas (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me

# Grafana (http://localhost:3001): admin login, and the read-only DB role it queries with
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
